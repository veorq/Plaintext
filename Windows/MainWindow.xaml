<Window x:Class="Plaintext.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plaintext"
        Width="1100"
        Height="760"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#55606060" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DocumentTitle"
                   Grid.Row="0"
                   Margin="24,17,24,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="1" Margin="28,0">
            <TextBox x:Name="Editor"
                     MaxWidth="760"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Margin="0,0,0,0"
                     Padding="22,72,22,72"
                     FontSize="19"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Hidden"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     SpellCheck.IsEnabled="False"
                     TextChanged="Editor_TextChanged"
                     PreviewKeyDown="Editor_PreviewKeyDown" />

            <Border x:Name="FindBar"
                    Visibility="Collapsed"
                    Panel.ZIndex="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,17,0,0"
                    Padding="11,8"
                    CornerRadius="10"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindTextBox" Width="145" Margin="4,0" VerticalContentAlignment="Center"
                             KeyDown="FindTextBox_KeyDown" />
                    <TextBox x:Name="ReplaceTextBox" Width="145" Margin="4,0" VerticalContentAlignment="Center"
                             KeyDown="ReplaceTextBox_KeyDown" />
                    <Button Content="Next" Click="FindNext_Click" />
                    <Button Content="Replace" Click="Replace_Click" />
                    <Button Content="All" Click="ReplaceAll_Click" />
                    <Button Content="×" Click="CloseFind_Click" FontSize="15" Padding="8,1" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="WordCount"
                   Grid.Row="2"
                   Margin="25,0,25,16"
                   HorizontalAlignment="Right"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Visibility="Collapsed" />

        <Grid x:Name="ModalOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#59000000">
            <Border x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    Width="470"
                    Height="420"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock Text="Theme" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
                        <UniformGrid Columns="6" Margin="0,10,0,0">
                            <Button Content="Paper" Tag="Paper" Click="ThemeButton_Click" FontSize="10" />
                            <Button Content="Snow" Tag="Snow" Click="ThemeButton_Click" FontSize="10" />
                            <Button Content="Linen" Tag="Linen" Click="ThemeButton_Click" FontSize="10" />
                            <Button Content="Ink" Tag="Ink" Click="ThemeButton_Click" FontSize="10" />
                            <Button Content="Graphite" Tag="Graphite" Click="ThemeButton_Click" FontSize="10" />
                            <Button Content="Midnight" Tag="Midnight" Click="ThemeButton_Click" FontSize="10" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,22,0,0">
                        <TextBlock Text="Typeface" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
                        <ComboBox x:Name="FontPicker" Width="280" Margin="0,8,0,0" DisplayMemberPath="Name"
                                  SelectionChanged="FontPicker_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                        <CheckBox x:Name="KeySoundCheck" Content="Key sound" Checked="KeySoundCheck_Changed" Unchecked="KeySoundCheck_Changed" />
                        <CheckBox x:Name="WordCountCheck" Content="Show word count" Margin="0,10,0,0"
                                  Checked="WordCountCheck_Changed" Unchecked="WordCountCheck_Changed" />
                    </StackPanel>

                    <Button Grid.Row="5" Content="Done" HorizontalAlignment="Right" Click="CloseModal_Click" IsDefault="True" />
                </Grid>
            </Border>

            <Border x:Name="CommandPanel"
                    Visibility="Collapsed"
                    Width="410"
                    Padding="9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12">
                <StackPanel>
                    <TextBox x:Name="CommandSearch" Margin="8" FontSize="16" TextChanged="CommandSearch_TextChanged"
                             KeyDown="CommandSearch_KeyDown" />
                    <Separator Margin="0,3" />
                    <StackPanel x:Name="CommandList" Margin="3" />
                </StackPanel>
            </Border>

            <Border x:Name="HistoryPanel"
                    Visibility="Collapsed"
                    Width="520"
                    Height="410"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Earlier Versions" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,7,0,14" TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                               Text="Automatic local snapshots. Restoring one replaces the current document and is saved as a new version." />
                    <ListBox x:Name="HistoryList" Grid.Row="2" DisplayMemberPath="DisplayName" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Restore" Click="RestoreHistory_Click" />
                        <Button Content="Done" Click="CloseModal_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
